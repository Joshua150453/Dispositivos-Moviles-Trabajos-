<?xml version="1.0" encoding="utf-8"?>
<!-- Gráfico de navegación: define las pantallas y sus transiciones -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:startDestination="@id/welcomeFragment">

    <!-- Pantalla de bienvenida -->
    <fragment
        android:id="@+id/welcomeFragment"
        android:name="com.example.juegocolores.ui.fragments.WelcomeFragment"
        android:label="Welcome">
        <action
            android:id="@+id/action_welcomeFragment_to_gameFragment"
            app:destination="@id/gameFragment" />
    </fragment>

    <!-- Pantalla principal del juego -->
    <fragment
        android:id="@+id/gameFragment"
        android:name="com.example.juegocolores.ui.fragments.GameFragment"
        android:label="Game">
        <action
            android:id="@+id/action_gameFragment_to_resultFragment"
            app:destination="@id/resultFragment" />
    </fragment>

    <!-- Pantalla de resultados -->
    <fragment
        android:id="@+id/resultFragment"
        android:name="com.example.juegocolores.ui.fragments.ResultFragment"
        android:label="Result">
        <argument
            android:name="score"
            app:argType="integer" />
        <action
            android:id="@+id/action_resultFragment_to_gameFragment"
            app:destination="@id/gameFragment" />
    </fragment>

</navigation>
